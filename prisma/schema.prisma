generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum Priority {
  LOW
  MEDIUM
  HIGH

  @@map("priority")
}

enum TitleType {
  MOVIE
  SERIES

  @@map("title_type")
}

model Title {
  id             Int       @id @default(autoincrement())
  type           TitleType
  name           String
  year           Int
  director       String?
  synopsis       String?
  posterUrl      String?   @map("poster_url")
  runtimeMinutes Int?      @map("runtime_minutes")
  tmdbId         Int?      @unique @map("tmdb_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  genres    TitleGenre[]
  watchedBy WatchedTitle[]
  seasons   Season[]
  favorites Favorite[]
  watchlist WatchlistItem[]

  @@unique([type, name, year])
  @@index([year])
  @@map("titles")
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  titles TitleGenre[]

  @@map("genres")
}

model TitleGenre {
  titleId Int @map("title_id")
  genreId Int @map("genre_id")

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@index([genreId])
  @@map("title_genres")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  active       Boolean  @default(true)
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  watchedTitles   WatchedTitle[]
  refreshTokens   RefreshToken[]
  watchedEpisodes WatchedEpisode[]
  favorites       Favorite[]
  watchlist       WatchlistItem[]

  @@map("users")
}

model WatchedTitle {
  userId    Int      @map("user_id")
  titleId   Int      @map("title_id")
  watchedAt DateTime @default(now()) @map("watched_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
  @@index([titleId])
  @@map("watched_titles")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Season {
  id        Int      @id @default(autoincrement())
  titleId   Int      @map("title_id")
  number    Int
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title    Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([titleId, number])
  @@map("seasons")
}

model Episode {
  id             Int      @id @default(autoincrement())
  seasonId       Int      @map("season_id")
  number         Int
  name           String
  runtimeMinutes Int?     @map("runtime_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  season          Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchedEpisodes WatchedEpisode[]

  @@unique([seasonId, number])
  @@map("episodes")
}

model WatchedEpisode {
  userId    Int      @map("user_id")
  episodeId Int      @map("episode_id")
  watchedAt DateTime @default(now()) @map("watched_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([episodeId])
  @@map("watched_episodes")
}

model Favorite {
  userId    Int      @map("user_id")
  titleId   Int      @map("title_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
  @@index([titleId])
  @@map("favorites")
}

model WatchlistItem {
  userId   Int       @map("user_id")
  titleId  Int       @map("title_id")
  priority Priority?
  addedAt  DateTime  @default(now()) @map("added_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
  @@index([titleId])
  @@map("watchlist")
}
