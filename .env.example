# Database
DB_USER=postgres
DB_PASSWORD=
DB_NAME=catalog
# Use host "localhost" when the API runs outside Docker.
# Inside docker compose, DATABASE_URL is overridden to point at the "db" service.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/catalog"

# JWT (generate the secret with: openssl rand -base64 48)
JWT_SECRET=
JWT_TOKEN_AUDIENCE=http://localhost:3000
JWT_TOKEN_ISSUER=http://localhost:3000
JWT_TTL="1h"

# App
NODE_ENV=development
PORT=3000
