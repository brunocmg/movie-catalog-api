# All variables are validated at boot (src/config/env.validation.ts):
# the app refuses to start with a clear message if one is missing or invalid.

# Database
DB_USER=postgres
DB_PASSWORD=
DB_NAME=catalog
# Use host "localhost" when the API runs outside Docker.
# Inside docker compose, DATABASE_URL is overridden to point at the "db" service.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/catalog"

# JWT — the secret needs at least 32 characters (openssl rand -base64 48)
JWT_SECRET=
JWT_TOKEN_AUDIENCE=http://localhost:3000
JWT_TOKEN_ISSUER=http://localhost:3000
JWT_TTL="1h"

# App
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

# CORS: "*", or a comma-separated list such as "https://app.example.com".
# Unset: any origin in development, CORS disabled in production.
CORS_ORIGINS=

# Reverse proxies in front of the app (Render, Nginx: 1). Needed so rate
# limiting sees the real client IP instead of the proxy.
TRUST_PROXY=0

# Rate limiting (per client IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=5
